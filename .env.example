# ═══════════════════════════════════════════════════
# Operative Dev Platform — Environment Variables
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Generate and fill ONLY the values marked ← FILL
# 3. Never commit .env to git
# 4. Read the CRITICAL note on ENCRYPTION_KEY
# ═══════════════════════════════════════════════════


# ─── ENCRYPTION KEY (CRITICAL) ──────────────────────
#
# This key encrypts ALL secrets stored in PostgreSQL:
# Anthropic API key, OpsGenie credentials, AWS keys,
# and all agent settings.
#
# ⚠️  GENERATE ONCE — NEVER LOSE — BACK UP IMMEDIATELY
#
# Step 1 — Generate:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Step 2 — Back up to AWS Secrets Manager BEFORE
#           adding to .env:
# aws secretsmanager create-secret \
#   --name operative/dev/encryption-key \
#   --secret-string "<your-generated-key>"
#
# Step 3 — Paste generated key below.
#
# If this key is lost, all encrypted data in
# PostgreSQL becomes permanently unreadable.
# You would need to wipe the database and
# reconfigure all credentials from scratch.
#
# For EKS production: inject via AWS Secrets Manager
# using ext-secrets operator — never store in a file.

ENCRYPTION_KEY=                                    # ← FILL — see instructions above


# ─── PostgreSQL ──────────────────────────────────────
#
# Internal database credentials.
# Generate a strong password:
# openssl rand -hex 16
#
# For EKS production: inject via AWS Secrets Manager

POSTGRES_USER=operative
POSTGRES_PASSWORD=                                 # ← FILL — openssl rand -hex 16
POSTGRES_DB=operative_db


# ─── Backend ─────────────────────────────────────────
#
# DATABASE_URL must match POSTGRES_* values above.
# Replace <password> with your POSTGRES_PASSWORD.

DATABASE_URL=postgresql+asyncpg://operative:<password>@postgres:5432/operative_db

# Generate SECRET_KEY:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# For EKS production: inject via AWS Secrets Manager

SECRET_KEY=                                        # ← FILL — python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=                                   # ← FILL — openssl rand -hex 32

POSTGRES_PORT=5433
BACKEND_PORT=8010
CORS_ORIGINS=http://localhost:3000


# ─── Portal ──────────────────────────────────────────
#
# HTTP Basic Auth for portal access.
# Leave blank for local dev (no auth prompt).
# Set for any shared or team environment.

PORTAL_PORT=3000
BACKEND_URL=http://backend:8000
PORTAL_USERNAME=                                   # ← FILL (optional for local dev)
PORTAL_PASSWORD=                                   # ← FILL (optional for local dev)


# ─── Authentication ──────────────────────────────────
#
# AUTH_MODE: none (default) / local / okta
# none  → No login required (backward compatible)
# local → Email/password login via JWT
# okta  → Corporate SSO (future, stub only)
#
# ADMIN_EMAIL + ADMIN_PASSWORD: used only when AUTH_MODE=local
# The first admin account is seeded from these on first startup.
# Leave blank when AUTH_MODE=none.

AUTH_MODE=none
ADMIN_EMAIL=          # ← only for AUTH_MODE=local
ADMIN_PASSWORD=       # ← only for AUTH_MODE=local


# ─── Agent Ports ─────────────────────────────────────

ALERT_ANALYSER_PORT=8001
CUR_ANALYSER_PORT=8002
KAFKA_ANALYSER_PORT=8003


# ═══════════════════════════════════════════════════
# THE FOLLOWING ARE CONFIGURED VIA PORTAL UI ONLY
# Do not add these to .env
# ═══════════════════════════════════════════════════
#
# Anthropic API key
# → Entered in Setup Wizard on first run
# → Stored encrypted in PostgreSQL
# → Never stored in any file
#
# Backend API key (admin access)
# → Auto-generated by Setup Wizard
# → Copy and save when shown — not shown again
# → Stored encrypted in PostgreSQL
#
# OpsGenie / JSM credentials
# → Alert Analyser → Settings → Data Source
# → Stored encrypted in PostgreSQL
#
# AWS credentials
# → CUR Analyser → Settings → Data Source
# → Stored encrypted in PostgreSQL
#
# All agent thresholds and tuning
# → Per-agent Settings UI
# → Stored encrypted in PostgreSQL
# ═══════════════════════════════════════════════════

# Inventory enrichment (Phase 1: file upload)
ENABLE_INVENTORY_ENRICHMENT=false


# ─── LLM Provider ────────────────────────────────────
#
# Controls which LLM provider all agents and the backend use.
# Default: anthropic (no change required for existing deployments)
#
# Supported providers:
#   anthropic  — Anthropic API directly (default)
#   bedrock    — AWS Bedrock (Anthropic models via AWS)
#   vertex     — Google Vertex AI (Anthropic models via GCP)
#
# Switching provider:
#   1. Set LLM_PROVIDER to the target provider
#   2. Set provider-specific credentials below
#   3. Rebuild and restart: docker compose up -d --build
#
# The Anthropic API key (entered via Portal Setup Wizard) is
# only used when LLM_PROVIDER=anthropic.
#
# LLM_MODEL: optional global model override.
# When set, overrides per-agent model config for all services.
# Leave blank to use per-agent model settings (recommended).

LLM_PROVIDER=anthropic
LLM_MODEL=                                         # ← optional global override


# ─── AWS Bedrock (required when LLM_PROVIDER=bedrock) ──
#
# Model IDs on Bedrock use the anthropic. prefix automatically.
# Example model: claude-sonnet-4-6 → anthropic.claude-sonnet-4-6
#
# Credentials: use IAM role (EKS) or access key (local dev).
# Required Bedrock permissions: bedrock:InvokeModel
#
# Region: BedrockMantle reads AWS_REGION or AWS_DEFAULT_REGION automatically.

AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1                      # alternative — BedrockMantle reads either
AWS_ACCESS_KEY_ID=your-access-key                  # ← FILL for Bedrock
AWS_SECRET_ACCESS_KEY=your-secret-key              # ← FILL for Bedrock


# ─── Google Vertex AI (required when LLM_PROVIDER=vertex) ──
#
# Requires Application Default Credentials (ADC) configured
# in the container, or a service account key.
# gcloud auth application-default login (local dev)

VERTEX_PROJECT_ID=                                 # ← FILL for Vertex
VERTEX_REGION=us-east5


# ─── Langfuse ────────────────────────────────────────
#
# LLM observability and tracing platform.
# These are default values suitable for local dev.
# For production, generate new secrets:
#   LANGFUSE_NEXTAUTH_SECRET: python3 -c "import secrets; print(secrets.token_hex(32))"
#   LANGFUSE_SALT: python3 -c "import secrets; print(secrets.token_hex(16))"

LANGFUSE_NEXTAUTH_SECRET=                    # ← FILL — python3 -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_SALT=                               # ← FILL — python3 -c "import secrets; print(secrets.token_hex(16))"
LANGFUSE_PUBLIC_KEY=                          # ← FILL — any string (e.g. lf-pk-yourorg)
LANGFUSE_SECRET_KEY=                         # ← FILL — any random string
