# ═══════════════════════════════════════════════════
# Operative Dev Platform — Environment Variables
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Generate and fill ONLY the values marked ← FILL
# 3. Never commit .env to git
# 4. Read the CRITICAL note on ENCRYPTION_KEY
# ═══════════════════════════════════════════════════


# ─── ENCRYPTION KEY (CRITICAL) ──────────────────────
#
# This key encrypts ALL secrets stored in PostgreSQL:
# Anthropic API key, OpsGenie credentials, AWS keys,
# and all agent settings.
#
# ⚠️  GENERATE ONCE — NEVER LOSE — BACK UP IMMEDIATELY
#
# Step 1 — Generate:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Step 2 — Back up to AWS Secrets Manager BEFORE
#           adding to .env:
# aws secretsmanager create-secret \
#   --name operative/dev/encryption-key \
#   --secret-string "<your-generated-key>"
#
# Step 3 — Paste generated key below.
#
# If this key is lost, all encrypted data in
# PostgreSQL becomes permanently unreadable.
# You would need to wipe the database and
# reconfigure all credentials from scratch.
#
# For EKS production: inject via AWS Secrets Manager
# using ext-secrets operator — never store in a file.

ENCRYPTION_KEY=                                    # ← FILL — see instructions above


# ─── PostgreSQL ──────────────────────────────────────
#
# Internal database credentials.
# Generate a strong password:
# openssl rand -hex 16
#
# For EKS production: inject via AWS Secrets Manager

POSTGRES_USER=operative
POSTGRES_PASSWORD=                                 # ← FILL — openssl rand -hex 16
POSTGRES_DB=operative_db


# ─── Backend ─────────────────────────────────────────
#
# DATABASE_URL must match POSTGRES_* values above.
# Replace <password> with your POSTGRES_PASSWORD.

DATABASE_URL=postgresql+asyncpg://operative:<password>@postgres:5432/operative_db

# Generate SECRET_KEY:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# For EKS production: inject via AWS Secrets Manager

SECRET_KEY=                                        # ← FILL — python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=                                   # ← FILL — openssl rand -hex 32

BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000


# ─── Portal ──────────────────────────────────────────
#
# HTTP Basic Auth for portal access.
# Leave blank for local dev (no auth prompt).
# Set for any shared or team environment.

PORTAL_PORT=3000
BACKEND_URL=http://backend:8000
PORTAL_USERNAME=                                   # ← FILL (optional for local dev)
PORTAL_PASSWORD=                                   # ← FILL (optional for local dev)


# ─── Agent Ports ─────────────────────────────────────

ALERT_ANALYSER_PORT=8001
CUR_ANALYSER_PORT=8002


# ═══════════════════════════════════════════════════
# THE FOLLOWING ARE CONFIGURED VIA PORTAL UI ONLY
# Do not add these to .env
# ═══════════════════════════════════════════════════
#
# Anthropic API key
# → Entered in Setup Wizard on first run
# → Stored encrypted in PostgreSQL
# → Never stored in any file
#
# Backend API key (admin access)
# → Auto-generated by Setup Wizard
# → Copy and save when shown — not shown again
# → Stored encrypted in PostgreSQL
#
# OpsGenie / JSM credentials
# → Alert Analyser → Settings → Data Source
# → Stored encrypted in PostgreSQL
#
# AWS credentials
# → CUR Analyser → Settings → Data Source
# → Stored encrypted in PostgreSQL
#
# All agent thresholds and tuning
# → Per-agent Settings UI
# → Stored encrypted in PostgreSQL
# ═══════════════════════════════════════════════════
