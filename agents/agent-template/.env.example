# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model to use for this agent (can be overridden per-deploy on Railway)
MODEL=claude-sonnet-4-6

# ─── Agent identity ───────────────────────────────────────────────────────────
# A stable UUID that never changes across deploys (generate once with uuidgen)
AGENT_ID=00000000-0000-0000-0000-000000000000

AGENT_SLUG=my-agent-slug
AGENT_NAME=My Agent Name

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Entire system prompt — change this without touching code
AGENT_SYSTEM_PROMPT=You are a helpful assistant.
