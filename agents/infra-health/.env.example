# Anthropic — required for agent to answer questions
ANTHROPIC_API_KEY=sk-ant-...

# Model override (optional — defaults to claude-sonnet-4-6)
# MODEL=claude-sonnet-4-6

# Agent identity (optional — defaults match manifest.json)
# AGENT_SLUG=infra-health
# AGENT_NAME=Infra Health Check

# Self-registration — set both to register with the UAP backend on startup
# REGISTRY_URL=https://your-backend.up.railway.app
# BACKEND_API_KEY=your-backend-api-key
